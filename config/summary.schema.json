{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string"},
    "source": {"type": "string"},
    "author": {"type": "string"},
    "language_used": {"type": "string", "enum": ["zh", "bilingual", "en"]},
    "core_points": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "maxItems": 5
    },
    "tickers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "stance": {"type": "string", "enum": ["bullish", "bearish", "neutral"]},
          "reason": {"type": "string"}
        },
        "required": ["name", "stance", "reason"]
      }
    }
  },
  "required": ["title", "source", "author", "language_used", "core_points", "tickers"]
}
